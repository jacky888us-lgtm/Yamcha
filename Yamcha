------------------------------------------------------------------------
-- Fruit discovery
------------------------------------------------------------------------
local function getRoot()
	local ch = LocalPlayer.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") and root.Parent then
		return root
	end
	return nil
end

local function resolvePart(inst)
	if inst:IsA("BasePart") then
		return inst
	end
	if inst:IsA("Tool") then
		local h = inst:FindFirstChild("Handle")
		if h and h:IsA("BasePart") then
			return h
		end
	end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

local function toFruit(inst)
	local needle = CONFIG.Fruit.NameContains
	if not needle or not matchesName(inst.Name, needle) then
		return nil
	end
	if Players:GetPlayerFromCharacter(inst) then
		return nil
	end
	if CONFIG.Fruit.Accept and not CONFIG.Fruit.Accept(inst) then
		return nil
	end
	local part = resolvePart(inst)
	if not part or not isSanePosition(part.Position, CONFIG.Teleport.MaxAbsCoordinate) then
		return nil
	end
	return { inst = inst, part = part, parent = inst.Parent, name = CONFIG.Fruit.DisplayName(inst) }
end

-- Returns array sorted by distance (unknown distance last).
local function scanFruits()
	local out = {}
	if not CONFIG.Fruit.NameContains then
		return out
	end
	for _, container in ipairs(CONFIG.Fruit.Containers) do
		if container and container.Parent then
			local list = CONFIG.Fruit.ScanDescendants and container:GetDescendants() or container:GetChildren()
			for _, inst in ipairs(list) do
				local f = toFruit(inst)
				if f then
					out[#out + 1] = f
				end
			end
		end
	end
	local root = getRoot()
	for _, f in ipairs(out) do
		f.distance = root and (f.part.Position - root.Position).Magnitude or nil
	end
	table.sort(out, function(a, b)
		if a.distance and b.distance then
			return a.distance < b.distance
		end
		return a.distance ~= nil
	end)
	return out
end

local function dumpWorkspace()
	local lines = { string.format("# PlaceId %d  JobId %s", game.PlaceId, game.JobId), "# ClassName\tName\tHasBasePart" }
	for _, inst in ipairs(workspace:GetChildren()) do
		lines[#lines + 1] = string.format("%s\t%s\t%s", inst.ClassName, inst.Name, tostring(resolvePart(inst) ~= nil))
	end
	local text = table.concat(lines, "\n")
	ensureDir()
	local wrote = EX.writefile and pcall(EX.writefile, path(P.Dump), text)
	local copied = EX.setclipboard and pcall(EX.setclipboard, text)
	setStatus(string.format("dump: %d rows%s%s", #lines - 2, wrote and " -> file" or "", copied and " + clipboard" or ""))
end

------------------------------------------------------------------------
-- Teleport + grab
------------------------------------------------------------------------
local busy = false

local function waitUntil(pred, timeout)
	local t0 = os.clock()
	while os.clock() - t0 < timeout do
		if pred() then
			return true
		end
		task.wait(0.05)
	end
	return pred()
end

local function fruitGone(f)
	return not f.part:IsDescendantOf(workspace)
end

local function pickedUp(f)
	return f.inst.Parent ~= f.parent
end

local function teleportTo(f, offset)
	local root = getRoot()
	if not root then
		return false, "no character"
	end
	if fruitGone(f) then
		return false, "fruit gone"
	end
	local function goal()
		return CFrame.new(f.part.Position + offset)
	end
	if Settings.InstantTP then
		root.CFrame = goal()
	else
		local dist = (f.part.Position + offset - root.Position).Magnitude
		local tween = TweenService:Create(
			root,
			TweenInfo.new(math.max(dist / CONFIG.Teleport.TweenSpeed, 0.05), Enum.EasingStyle.Linear),
			{ CFrame = goal() }
		)
		tween:Play()
		while tween.PlaybackState == Enum.PlaybackState.Playing do
			if not alive or not root.Parent or fruitGone(f) then
				tween:Cancel()
				return false, "fruit gone or character lost"
			end
			task.wait()
		end
	end
	if fruitGone(f) or not root.Parent then
		return false, "fruit gone"
	end
	root.CFrame = goal() -- final snap to the fruit's current position
	root.AssemblyLinearVelocity = Vector3.zero
	return true
end

local function grab(f)
	local root = getRoot()
	if not root then
		return false, "no character"
	end
	if fruitGone(f) then
		return false, "fruit gone"
	end
	local mode = Settings.GrabMode

	if mode ~= "Teleport" then
		if EX.firetouch then
			pcall(EX.firetouch, root, f.part, 0)
			task.wait()
			pcall(EX.firetouch, root, f.part, 1)
			if waitUntil(function()
				return pickedUp(f)
			end, CONFIG.Grab.TouchConfirmSeconds) then
				return true, "touch"
			end
		elseif mode == "Touch" then
			return false, "firetouchinterest missing"
		end
		if mode == "Touch" then
			return false, "touch not confirmed"
		end
	end

	local origin = root.CFrame
	local ok, why = teleportTo(f, CONFIG.Teleport.GrabOffset)
	local got = ok and waitUntil(function()
		return pickedUp(f)
	end, CONFIG.Grab.TeleportConfirmSeconds)
	if CONFIG.Grab.ReturnAfterGrab and root.Parent then
		root.CFrame = origin
		root.AssemblyLinearVelocity = Vector3.zero
	end
	if got then
		return true, "teleport"
	end
	return false, ok and "pickup not confirmed" or why
end

local function runExclusive(label, fn)
	if busy then
		setStatus("busy, wait a sec")
		return
	end
	busy = true
	task.spawn(function()
		local ok, a, b = pcall(fn)
		busy = false
		if not ok then
			setStatus(label .. " error: " .. tostring(a))
		elseif a == false then
			setStatus(label .. " failed: " .. tostring(b))
		elseif a == true then
			setStatus(label .. " ok" .. (b and (" (" .. tostring(b) .. ")") or ""))
		end
	end)
end

------------------------------------------------------------------------
-- Server list + hunt
------------------------------------------------------------------------
local function httpGet(url)
	if EX.request then
		local ok, res = pcall(EX.request, { Url = url, Method = "GET" })
		if ok and type(res) == "table" then
			return res.StatusCode, res.Body
		end
		return nil, tostring(res)
	end
	local ok, body = pcall(function()
		return game:HttpGet(url)
	end)
	if ok then
		return 200, body
	end
	return nil, tostring(body)
end

-- Partial page failure = failure (returns nil, reason).
local function fetchServers()
	local all, cursor = {}, nil
	for _ = 1, CONFIG.Servers.MaxPages do
		local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId)
		if cursor then
			url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
		end
		local status, body = httpGet(url)
		if status ~= 200 then
			return nil, "HTTP " .. tostring(status) .. " " .. string.sub(tostring(body), 1, 60)
		end
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(body)
		end)
		if not ok or type(decoded) ~= "table" or type(decoded.data) ~= "table" then
			return nil, "unexpected response shape"
		end
		for _, s in ipairs(decoded.data) do
			all[#all + 1] = s
		end
		cursor = decoded.nextPageCursor
		if type(cursor) ~= "string" then
			break
		end
	end
	return all
end

local hunting = false
local huntToken = 0
local queued = false
local huntToggle -- set by UI

local function canHunt()
	if not CONFIG.Fruit.NameContains then
		return false, "fruit matcher unset (use Dump)"
	end
	if not EX.queue then
		return false, "queue_on_teleport missing"
	end
	if not (EX.isfile and EX.readfile and EX.writefile) then
		return false, "file functions missing"
	end
	if not EX.isfile(path(P.Script)) then
		return false, "save script to workspace/" .. path(P.Script)
	end
	return true
end

local function stopHunt(msg)
	hunting = false
	huntToken = huntToken + 1
	state.hunting = false
	saveState()
	if huntToggle then
		huntToggle.set(false)
	end
	if msg then
		setStatus(msg)
	end
end

local function teleportToServer(jobId)
	local ok, err = pcall(TeleportService.TeleportToPlaceInstance, TeleportService, game.PlaceId, jobId, LocalPlayer)
	return ok, err
end

local function hop(token)
	while alive and hunting and token == huntToken do
		setStatus("hunt: fetching servers...")
		local list, err = fetchServers()
		if not list then
			setStatus("hunt: list failed - " .. tostring(err))
			task.wait(CONFIG.Hunt.RetrySeconds)
			continue
		end
		local now = os.time()
		state.visited = pruneVisited(state.visited, now, CONFIG.Servers.VisitedTtlSeconds)
		local pick = chooseServer(list, state.visited, game.JobId, now, CONFIG.Servers.VisitedTtlSeconds, CONFIG.Servers.MinFreeSlots, math.random)
		if not pick then
			setStatus("hunt: no unvisited server, clearing history")
			state.visited = {}
			task.wait(CONFIG.Hunt.RetrySeconds)
			continue
		end
		state.visited[game.JobId] = now
		state.visited[pick.id] = now
		saveState()
		if not queued then
			local okRead, src = pcall(EX.readfile, path(P.Script))
			if not okRead or type(src) ~= "string" or #src == 0 then
				stopHunt("hunt stopped: cannot read " .. path(P.Script))
				return
			end
			EX.queue(src)
			queued = true
		end
		setStatus(string.format("hunt: joining %s (%d/%d)", string.sub(pick.id, 1, 6), pick.playing, pick.maxPlayers))
		local ok, e = teleportToServer(pick.id)
		if ok then
			return -- TeleportInitFailed handler retries if the join is refused
		end
		setStatus("hunt: teleport error - " .. tostring(e))
		task.wait(CONFIG.Hunt.RetrySeconds)
	end
end

local function huntCycle(token)
	if not game:IsLoaded() then
		game.Loaded:Wait()
	end
	setStatus("hunt: settling...")
	task.wait(CONFIG.Hunt.SettleSeconds)
	if not alive or token ~= huntToken then
		return
	end
	local fruits = scanFruits()
	if #fruits > 0 then
		stopHunt("fruit found: " .. fruits[1].name)
		notify("Wrench Fruit", "Fruit found: " .. fruits[1].name)
		return
	end
	hop(token)
end

local function startHunt()
	local ok, why = canHunt()
	if not ok then
		setStatus("hunt gated: " .. why)
		return false
	end
	hunting = true
	state.hunting = true
	saveState()
	huntToken = huntToken + 1
	local token = huntToken
	task.spawn(huntCycle, token)
	return true
end

track(TeleportService.TeleportInitFailed:Connect(function(player, result, message)
	if player ~= LocalPlayer or not hunting then
		return
	end
	setStatus("hunt: join refused (" .. tostring(result) .. "), retrying")
	local token = huntToken
	task.delay(CONFIG.Hunt.RetrySeconds, function()
		if alive and hunting and token == huntToken then
			hop(token)
		end
	end)
end))

