			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "W",
			Font = Enum.Font.GothamBold, TextSize = 20, TextColor3 = COLOR.bg,
		}, bubble)
	end
	local bubbleDrag = makeDraggable(bubble, bubble)

	-- Window
	local win = mk("Frame", {
		Name = "Window",
		Size = UDim2.fromOffset(290, 340),
		Position = UDim2.new(0, 20, 0, 70),
		BackgroundColor3 = COLOR.bg,
		BorderSizePixel = 0,
	}, gui)
	round(win, 10)
	mk("UIStroke", { Color = COLOR.accent, Thickness = 1.5, Transparency = 0.4 }, win)

	local function setVisible(v)
		win.Visible = v
		bubble.Visible = not v
	end

	track(bubble.Activated:Connect(function()
		if not bubbleDrag.moved then
			setVisible(true)
		end
	end))
	track(UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == CONFIG.UI.ToggleKey then
			setVisible(not win.Visible)
		end
	end))

	-- Header
	local header = mk("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = COLOR.panel, BorderSizePixel = 0 }, win)
	round(header, 10)
	makeDraggable(header, win)
	local icon = mk("ImageLabel", {
		Size = UDim2.fromOffset(26, 26), Position = UDim2.fromOffset(6, 5),
		BackgroundColor3 = COLOR.accent, Image = logo or "",
	}, header)
	round(icon, 13)
	mk("TextLabel", {
		Size = UDim2.new(1, -110, 1, 0), Position = UDim2.fromOffset(38, 0), BackgroundTransparency = 1,
		Text = "Wrench Fruit Finder", Font = Enum.Font.GothamBold, TextSize = 13,
		TextColor3 = COLOR.text, TextXAlignment = Enum.TextXAlignment.Left,
	}, header)

	local function headerButton(text, xFromRight, cb)
		local b = mk("TextButton", {
			Size = UDim2.fromOffset(26, 24), Position = UDim2.new(1, xFromRight, 0, 6),
			BackgroundColor3 = COLOR.bg, Text = text, Font = Enum.Font.GothamBold,
			TextSize = 14, TextColor3 = COLOR.text,
		}, header)
		round(b, 6)
		track(b.Activated:Connect(cb))
	end
	headerButton("-", -62, function()
		setVisible(false)
	end)
	headerButton("x", -32, function()
		genv.WrenchFruitFinder.Unload()
	end)

	-- Tabs
	local pages = {}
	local tabButtons = {}
	local function selectTab(name)
		for n, p in pairs(pages) do
			p.Visible = (n == name)
			tabButtons[n].BackgroundColor3 = (n == name) and COLOR.accent or COLOR.panel
			tabButtons[n].TextColor3 = (n == name) and COLOR.bg or COLOR.text
		end
	end
	local function addTab(name, x)
		local b = mk("TextButton", {
			Size = UDim2.fromOffset(133, 24), Position = UDim2.fromOffset(x, 42),
			BackgroundColor3 = COLOR.panel, Text = name, Font = Enum.Font.GothamMedium,
			TextSize = 12, TextColor3 = COLOR.text,
		}, win)
		round(b, 6)
		tabButtons[name] = b
		pages[name] = mk("Frame", {
			Size = UDim2.fromOffset(274, 240), Position = UDim2.fromOffset(8, 72),
			BackgroundTransparency = 1, Visible = false,
		}, win)
		track(b.Activated:Connect(function()
			selectTab(name)
		end))
	end
	addTab("Fruit", 8)
	addTab("Server", 149)

	-- Status bar
	statusLabel = mk("TextLabel", {
		Size = UDim2.new(1, -16, 0, 22), Position = UDim2.new(0, 8, 1, -26), BackgroundColor3 = COLOR.panel,
		Text = "ready", Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = COLOR.dim,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}, win)
	round(statusLabel, 6)
	mk("UIPadding", { PaddingLeft = UDim.new(0, 6) }, statusLabel)

	-- Widgets
	local function button(parent, text, size, pos, cb)
		local b = mk("TextButton", {
			Size = size, Position = pos, BackgroundColor3 = COLOR.panel, Text = text,
			Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = COLOR.text,
		}, parent)
		round(b, 6)
		track(b.Activated:Connect(cb))
		return b
	end

	local function toggle(parent, label, size, pos, initial, onChange)
		local value = initial
		local b = mk("TextButton", {
			Size = size, Position = pos, Font = Enum.Font.GothamMedium, TextSize = 11, Text = "",
			BackgroundColor3 = COLOR.panel, TextColor3 = COLOR.text,
		}, parent)
		round(b, 6)
		local function paint()
			b.Text = label .. ": " .. (value and "ON" or "OFF")
			b.BackgroundColor3 = value and COLOR.accent or COLOR.panel
			b.TextColor3 = value and COLOR.bg or COLOR.text
		end
		paint()
		track(b.Activated:Connect(function()
			local nv = not value
			if onChange(nv) ~= false then
				value = nv
			end
			paint()
		end))
		return {
			set = function(v)
				value = v
				paint()
			end,
		}
	end

	local function listFrame(parent, y, h)
		local sf = mk("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, h), Position = UDim2.fromOffset(0, y), BackgroundColor3 = COLOR.panel,
			BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		}, parent)
		round(sf, 6)
		mk("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, sf)
		return sf
	end

	local function label(parent, text, size, pos, textSize, xAlign)
		return mk("TextLabel", {
			Size = size, Position = pos, BackgroundTransparency = 1, Text = text, Font = Enum.Font.Gotham,
			TextSize = textSize or 11, TextColor3 = COLOR.text, TextXAlignment = xAlign or Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, parent)
	end

	-------------------------------------------------- Fruit page
	local fp = pages.Fruit
	toggle(fp, "Auto Grab", UDim2.fromOffset(88, 24), UDim2.fromOffset(0, 0), Settings.AutoGrab, function(v)
		Settings.AutoGrab = v
		saveState()
	end)
	toggle(fp, "Instant TP", UDim2.fromOffset(88, 24), UDim2.fromOffset(92, 0), Settings.InstantTP, function(v)
		Settings.InstantTP = v
		saveState()
	end)
	local modeOrder = { "Auto", "Touch", "Teleport" }
	local modeButton
	modeButton = button(fp, "Grab: " .. Settings.GrabMode, UDim2.fromOffset(90, 24), UDim2.fromOffset(184, 0), function()
		for i, m in ipairs(modeOrder) do
			if m == Settings.GrabMode then
				Settings.GrabMode = modeOrder[(i % #modeOrder) + 1]
				break
			end
		end
		modeButton.Text = "Grab: " .. Settings.GrabMode
		saveState()
	end)
	button(fp, "Dump", UDim2.fromOffset(60, 22), UDim2.fromOffset(0, 28), dumpWorkspace)
	local countLabel = label(fp, "Fruit: 0", UDim2.fromOffset(200, 22), UDim2.fromOffset(66, 28), 11)
	local fruitList = listFrame(fp, 54, 186)
	local emptyLabel = label(fruitList, "", UDim2.new(1, -8, 0, 40), UDim2.fromOffset(4, 4), 11)
	emptyLabel.TextWrapped = true
	emptyLabel.TextColor3 = COLOR.dim

	local fruitRows = {}
	local function makeFruitRow(f)
		local fr = mk("Frame", { Size = UDim2.new(1, -6, 0, 26), BackgroundColor3 = COLOR.bg, BorderSizePixel = 0 }, fruitList)
		round(fr, 5)
		label(fr, f.name, UDim2.fromOffset(108, 26), UDim2.fromOffset(6, 0), 11)
		local dist = label(fr, "?", UDim2.fromOffset(44, 26), UDim2.fromOffset(114, 0), 11)
		dist.TextColor3 = COLOR.accent
		button(fr, "TP", UDim2.fromOffset(36, 20), UDim2.fromOffset(160, 3), function()
			local live = toFruit(f.inst)
			if not live then
				return setStatus("fruit no longer valid")
			end
			runExclusive("teleport", function()
				return teleportTo(live, CONFIG.Teleport.HoverOffset)
			end)
		end)
		button(fr, "Grab", UDim2.fromOffset(44, 20), UDim2.fromOffset(200, 3), function()
			local live = toFruit(f.inst)
			if not live then
				return setStatus("fruit no longer valid")
			end
			runExclusive("grab", function()
				return grab(live)
			end)
		end)
		return { frame = fr, dist = dist }
	end

	local function syncFruitRows(fruits)
		local seen, n = {}, 0
		for i, f in ipairs(fruits) do
			if i > CONFIG.UI.MaxRows then
				break
			end
			n = n + 1
			seen[f.inst] = true
			local r = fruitRows[f.inst]
			if not r then
				r = makeFruitRow(f)
				fruitRows[f.inst] = r
			end
			r.dist.Text = formatDistance(f.distance)
			r.frame.LayoutOrder = i
		end
		for inst, r in pairs(fruitRows) do
			if not seen[inst] then
				r.frame:Destroy()
				fruitRows[inst] = nil
			end
		end
		countLabel.Text = "Fruit: " .. tostring(#fruits) .. "  (studs)"
		if not CONFIG.Fruit.NameContains then
			emptyLabel.Text = "Fruit matcher is UNSET. Press Dump, then set Fruit.NameContains."
		elseif n == 0 then
			emptyLabel.Text = "No fruit in this server right now."
		end
		emptyLabel.Visible = (n == 0)
	end

	-------------------------------------------------- Server page
	local sp = pages.Server
	huntToggle = toggle(sp, "Hunt", UDim2.fromOffset(100, 24), UDim2.fromOffset(0, 0), false, function(v)
		if v then
			return startHunt()
		end
		stopHunt("hunt stopped")
	end)
	local serverList = listFrame(sp, 60, 180)
	local serverRows = {}

	local function renderServers(list)
		for _, r in ipairs(serverRows) do
			r:Destroy()
		end
		serverRows = {}
		local shown = 0
		for _, s in ipairs(list) do
			if shown >= CONFIG.Servers.ListRows then
				break
			end
			if type(s.id) == "string" and s.id ~= game.JobId and isFinite(s.playing) and isFinite(s.maxPlayers) then
				shown = shown + 1
				local fr = mk("Frame", { Size = UDim2.new(1, -6, 0, 26), BackgroundColor3 = COLOR.bg, BorderSizePixel = 0, LayoutOrder = shown }, serverList)
				round(fr, 5)
				label(fr, string.sub(s.id, 1, 8) .. "  " .. s.playing .. "/" .. s.maxPlayers, UDim2.fromOffset(170, 26), UDim2.fromOffset(6, 0), 11)
				button(fr, "Join", UDim2.fromOffset(50, 20), UDim2.fromOffset(200, 3), function()
					local ok, e = teleportToServer(s.id)
					setStatus(ok and "joining server..." or ("join error: " .. tostring(e)))
				end)
				serverRows[#serverRows + 1] = fr
			end
		end
	end

	button(sp, "Hop now", UDim2.fromOffset(80, 24), UDim2.fromOffset(104, 0), function()
		if busy then
			return
		end
		busy = true
		task.spawn(function()
			local list, err = fetchServers()
			if not list then
				busy = false
				return setStatus("list failed: " .. tostring(err))
			end
			local now = os.time()
			local pick = chooseServer(list, state.visited, game.JobId, now, CONFIG.Servers.VisitedTtlSeconds, CONFIG.Servers.MinFreeSlots, math.random)
			busy = false
			if not pick then
				return setStatus("no unvisited server")
			end
			state.visited[game.JobId] = now
			state.visited[pick.id] = now
			saveState()
			local ok, e = teleportToServer(pick.id)
			setStatus(ok and "hopping..." or ("hop error: " .. tostring(e)))
		end)
	end)
	button(sp, "Refresh", UDim2.fromOffset(84, 24), UDim2.fromOffset(188, 0), function()
		task.spawn(function()
			setStatus("fetching servers...")
			local list, err = fetchServers()
			if not list then
				return setStatus("list failed: " .. tostring(err))
			end
			renderServers(list)
			setStatus(string.format("%d servers fetched", #list))
		end)
	end)
	local note = label(sp, "Hunt joins a server, scans it, hops if empty. Fruit presence cannot be read before joining.", UDim2.fromOffset(274, 28), UDim2.fromOffset(0, 28), 10)
	note.TextWrapped = true
	note.TextColor3 = COLOR.dim
	note.TextTruncate = Enum.TextTruncate.None

	selectTab("Fruit")
	setVisible(true)
	return syncFruitRows
end

local syncFruitRows = buildGui()

------------------------------------------------------------------------
-- Main loop
------------------------------------------------------------------------
local lastAutoGrab = 0
task.spawn(function()
	while alive do
		local ok, err = pcall(function()
			local fruits = scanFruits()
			syncFruitRows(fruits)
			if Settings.AutoGrab and not busy and #fruits > 0 and getRoot()
				and os.clock() - lastAutoGrab >= CONFIG.Grab.AutoGrabIntervalSeconds then
				lastAutoGrab = os.clock()
				runExclusive("auto-grab", function()
					local live = toFruit(fruits[1].inst)
					if not live then
						return false, "fruit gone"
					end
					return grab(live)
				end)
			end
		end)
		if not ok then
			setStatus("tick error: " .. tostring(err))
		end
		task.wait(CONFIG.UI.RefreshSeconds)
	end
end)

------------------------------------------------------------------------
-- Startup status + resume hunt after a hop
------------------------------------------------------------------------
if CONFIG.ExpectedPlaceIds and not CONFIG.ExpectedPlaceIds[game.PlaceId] then
	setStatus("warning: PlaceId " .. tostring(game.PlaceId) .. " not in ExpectedPlaceIds")
elseif not CONFIG.Fruit.NameContains then
	setStatus("fruit matcher UNSET - press Dump")
end

if state.hunting then
	local ok, why = canHunt()
	if ok then
		hunting = true
		huntToken = huntToken + 1
		huntToggle.set(true)
		task.spawn(huntCycle, huntToken)
	else
		stopHunt("hunt cancelled: " .. why)
	end
end

------------------------------------------------------------------------
-- Unload (single cleanup path)
------------------------------------------------------------------------
genv.WrenchFruitFinder = {
	Unload = function()
		alive = false
		hunting = false
		huntToken = huntToken + 1
		for _, c in ipairs(connections) do
			pcall(function()
				c:Disconnect()
			end)
		end
		table.clear(connections)
		if gui then
			pcall(function()
				gui:Destroy()
			end)
		end
		genv.WrenchFruitFinder = nil
	end,
}
