------------------------------------------------------------------------
-- Pure helpers (checkable without the game)
------------------------------------------------------------------------
local function matchesName(name, needle)
	if type(name) ~= "string" or type(needle) ~= "string" or needle == "" then
		return false
	end
	return string.find(string.lower(name), string.lower(needle), 1, true) ~= nil
end

local function formatDistance(d)
	if type(d) ~= "number" or d ~= d or d == math.huge then
		return "?"
	end
	if d >= 1000 then
		return string.format("%.1fk", d / 1000)
	end
	return string.format("%d", math.floor(d + 0.5))
end

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function isSanePosition(v, bound)
	return isFinite(v.X) and isFinite(v.Y) and isFinite(v.Z)
		and math.abs(v.X) < bound and math.abs(v.Y) < bound and math.abs(v.Z) < bound
end

local function pruneVisited(visited, now, ttl)
	local out = {}
	for id, ts in pairs(visited) do
		if type(id) == "string" and type(ts) == "number" and now - ts < ttl then
			out[id] = ts
		end
	end
	return out
end

-- servers: array of { id, playing, maxPlayers }. rand(lo, hi) -> integer.
local function chooseServer(servers, visited, currentJobId, now, ttl, minFreeSlots, rand)
	local pool = {}
	for _, s in ipairs(servers) do
		if type(s) == "table" and type(s.id) == "string" and s.id ~= currentJobId
			and isFinite(s.playing) and isFinite(s.maxPlayers)
			and s.playing + minFreeSlots <= s.maxPlayers then
			local seen = visited[s.id]
			if not (seen and now - seen < ttl) then
				pool[#pool + 1] = s
			end
		end
	end
	if #pool == 0 then
		return nil
	end
	return pool[rand(1, #pool)]
end

