local function ensureDir()
	if EX.isfolder and EX.makefolder and not EX.isfolder(P.Dir) then
		pcall(EX.makefolder, P.Dir)
	end
end

local function loadState()
	if not (EX.isfile and EX.readfile) or not EX.isfile(path(P.State)) then
		return
	end
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(EX.readfile(path(P.State)))
	end)
	if not ok or type(decoded) ~= "table" then
		return
	end
	state.hunting = decoded.hunting == true
	if type(decoded.visited) == "table" then
		state.visited = pruneVisited(decoded.visited, os.time(), CONFIG.Servers.VisitedTtlSeconds)
	end
	if type(decoded.settings) == "table" then
		local s = decoded.settings
		state.settings.AutoGrab = s.AutoGrab == true
		state.settings.InstantTP = s.InstantTP == true
		if s.GrabMode == "Auto" or s.GrabMode == "Touch" or s.GrabMode == "Teleport" then
			state.settings.GrabMode = s.GrabMode
		end
	end
end

local function saveState()
	if not EX.writefile then
		return
	end
	ensureDir()
	pcall(function()
		EX.writefile(path(P.State), HttpService:JSONEncode(state))
	end)
end

